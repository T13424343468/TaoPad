<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AntPad.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 框架控件与主题资源的总入口，必须最先加载；启动字典用水墨（默认主题），随后由 ThemeService 统一 Apply -->
        <Controls:XamlControlsResources xmlns:Controls="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="ms-appx:///Themes/Ant.Ink.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
