<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AntPad.Views.FindReplacePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- VS 式查找/替换：查找行（输入 + ↑↓ + ×）+ 可折叠替换行 + 选项行；
       主题由 ApplyTheme() 直涂（Ant.Surface/Ant.Border/Ant.Text），不依赖 ThemeResource 重估 -->
  <Border x:Name="RootBorder"
          Background="White"
          BorderBrush="LightGray"
          BorderThickness="1" CornerRadius="8" Padding="12,10">
    <StackPanel Spacing="8" Width="440">

      <!-- 查找行：Enter 查下一个，Shift+Enter / Alt+Enter 查上一个 -->
      <Grid ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="PatternBox" PlaceholderText="查找内容（Enter 下一个，Shift+Enter 上一个）"
                 Height="32" VerticalContentAlignment="Center"/>
        <Button Grid.Column="1" x:Name="FindPrevBtn" Content="↑" Click="OnFindPrev"
                Width="32" Height="32" Padding="0" FontWeight="Bold"
                ToolTipService.ToolTip="查找上一个（Shift+Enter）"/>
        <Button Grid.Column="2" x:Name="FindNextBtn" Content="↓" Click="OnFindNext"
                Width="32" Height="32" Padding="0" FontWeight="Bold"
                ToolTipService.ToolTip="查找下一个（Enter）"/>
        <Button Grid.Column="3" x:Name="CloseBtn" Content="×" Click="OnClose"
                Width="32" Height="32" Padding="0" FontWeight="Bold"
                ToolTipService.ToolTip="关闭（Esc）"/>
      </Grid>

      <!-- 替换行：Ctrl+F 只查找时整行折叠；Ctrl+H 展开替换 -->
      <Grid x:Name="ReplaceRow" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="ReplaceBox" PlaceholderText="替换为" Height="32"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Column="1" x:Name="ReplaceBtn" Content="替换" Click="OnReplace"
                Height="32" Padding="12,0"/>
        <Button Grid.Column="2" x:Name="ReplaceAllBtn" Content="全部替换" Click="OnReplaceAll"
                Height="32" Padding="12,0"/>
      </Grid>

      <!-- 选项行：开关 + 结果计数 -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <CheckBox x:Name="CaseCheck" Content="区分大小写" MinWidth="0"/>
        <CheckBox x:Name="WordCheck" Content="全字匹配" MinWidth="0"/>
        <CheckBox x:Name="RegexCheck" Content="正则" MinWidth="0"/>
        <TextBlock x:Name="ResultText" FontSize="12" MinHeight="16" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
