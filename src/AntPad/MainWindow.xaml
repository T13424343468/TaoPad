<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AntPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AntPad.Views">

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="8">
        <Image Source="ms-appx:///Assets/TaoPad.png" Width="20" Height="20"/>
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="13"/>
      </StackPanel>
    </Grid>

    <!-- 菜单栏 -->
    <MenuBar Grid.Row="1">
      <MenuBarItem Title="文件" Tapped="OnMenuTapped" PointerPressed="OnMenuPressed">
        <MenuFlyoutItem Text="新建" Click="OnNew">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="打开…" Click="OnOpen">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSubItem x:Name="RecentMenu" Text="最近文件">
          <MenuFlyoutItem Text="（空）" IsEnabled="False"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="保存" Click="OnSave">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="S"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="另存为…" Click="OnSaveAs">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="全部保存" Click="OnSaveAll"/>
        <MenuFlyoutSubItem Text="导出">
          <MenuFlyoutItem Text="导出为可打印 HTML（PDF 用）…" Click="OnExportPrintableHtml"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="关闭标签" Click="OnCloseTab">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="W"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="退出" Click="OnExit"/>
      </MenuBarItem>

      <MenuBarItem Title="编辑" Tapped="OnMenuTapped" PointerPressed="OnMenuPressed">
        <MenuFlyoutItem Text="撤销（Ctrl+Z）" Click="OnUndo"/>
        <MenuFlyoutItem Text="重做（Ctrl+Y）" Click="OnRedo"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="剪切（Ctrl+X）" Click="OnCut"/>
        <MenuFlyoutItem Text="复制（Ctrl+C）" Click="OnCopy"/>
        <MenuFlyoutItem Text="粘贴（Ctrl+V）" Click="OnPaste"/>
        <MenuFlyoutItem Text="全选（Ctrl+A）" Click="OnSelectAll"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="插入时间日期（F5）" Click="OnInsertTime">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSubItem Text="行操作">
          <MenuFlyoutItem Text="删除当前行（Ctrl+Shift+L）" Click="OnDeleteLine"/>
          <MenuFlyoutItem Text="复制当前行（Ctrl+D）" Click="OnDuplicateLine"/>
          <MenuFlyoutItem Text="上移当前行（Alt+↑）" Click="OnMoveLineUp"/>
          <MenuFlyoutItem Text="下移当前行（Alt+↓）" Click="OnMoveLineDown"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSubItem Text="大小写转换">
          <MenuFlyoutItem Text="转为大写（Ctrl+Shift+U）" Click="OnToUpper"/>
          <MenuFlyoutItem Text="转为小写（Ctrl+U）" Click="OnToLower"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="格式化文档（Ctrl+K, Ctrl+D）" Click="OnFormat">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="F"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="注释选区（Ctrl+K, C）" Click="OnCommentSelection"/>
        <MenuFlyoutItem Text="取消注释选区（Ctrl+K, U）" Click="OnUncommentSelection"/>
      </MenuBarItem>

      <MenuBarItem Title="搜索" Tapped="OnMenuTapped" PointerPressed="OnMenuPressed">
        <MenuFlyoutItem Text="查找" Click="OnFind">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="替换" Click="OnReplace">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="H"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="在文件中查找…" Click="OnFindInFiles">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="F"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="查找下一个" Click="OnFindNext">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Key="F3"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="查找上一个" Click="OnFindPrev">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Shift" Key="F3"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="转到行…" Click="OnGoto">
          <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="G"/>
          </MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
      </MenuBarItem>

      <MenuBarItem Title="查看" Tapped="OnMenuTapped" PointerPressed="OnMenuPressed">
        <ToggleMenuFlyoutItem x:Name="WrapToggle" Text="自动换行" Click="OnWrapToggle"/>
        <ToggleMenuFlyoutItem x:Name="LineNoToggle" Text="显示行号" IsChecked="True" Click="OnLineNoToggle"/>
        <MenuFlyoutSubItem Text="缩放">
          <MenuFlyoutItem Text="放大" Click="OnZoomIn">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control" Key="Add"/>
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutItem Text="缩小" Click="OnZoomOut">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control" Key="Subtract"/>
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutItem Text="复位" Click="OnZoomReset">
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control" Key="Number0"/>
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
        </MenuFlyoutSubItem>
      </MenuBarItem>

      <!-- 语言菜单：项与文案全部来自 LangDef.All 唯一清单，构造时动态生成
           （道法总纲·知常曰明：语言只此一处定义，菜单不再另抄一份） -->
      <MenuBarItem x:Name="LangMenu" Title="语言"/>

      <MenuBarItem Title="编码" Tapped="OnMenuTapped" PointerPressed="OnMenuPressed">
        <MenuFlyoutSubItem Text="保存编码">
          <ToggleMenuFlyoutItem x:Name="EncUtf8" Text="UTF-8" Click="OnEncClick"/>
          <ToggleMenuFlyoutItem x:Name="EncUtf8Bom" Text="UTF-8 BOM" Click="OnEncClick"/>
          <ToggleMenuFlyoutItem x:Name="EncUtf16" Text="UTF-16 LE" Click="OnEncClick"/>
          <ToggleMenuFlyoutItem x:Name="EncGbk" Text="GBK" Click="OnEncClick"/>
          <ToggleMenuFlyoutItem x:Name="EncBig5" Text="Big5" Click="OnEncClick"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSubItem Text="换行符">
          <ToggleMenuFlyoutItem x:Name="EolCrLf" Text="Windows (CRLF)" Click="OnEolClick"/>
          <ToggleMenuFlyoutItem x:Name="EolLf" Text="Unix (LF)" Click="OnEolClick"/>
          <ToggleMenuFlyoutItem x:Name="EolCr" Text="Mac (CR)" Click="OnEolClick"/>
        </MenuFlyoutSubItem>
      </MenuBarItem>

      <MenuBarItem Title="主题" Tapped="OnMenuTapped" PointerPressed="OnMenuPressed">
        <ToggleMenuFlyoutItem x:Name="ThemeInk" Text="水墨" Click="OnThemeClick"/>
        <ToggleMenuFlyoutItem x:Name="ThemeSky" Text="天青" Click="OnThemeClick"/>
        <ToggleMenuFlyoutItem x:Name="ThemeNight" Text="墨夜" Click="OnThemeClick"/>
      </MenuBarItem>

      <MenuBarItem Title="工具" Tapped="OnMenuTapped" PointerPressed="OnMenuPressed">
        <MenuFlyoutItem x:Name="SettingsItem" Text="设置…" Click="OnSettings"/>
      </MenuBarItem>
    </MenuBar>

    <!-- 编辑区（层色底由直涂接通，见 ApplyThemeBrushes） -->
    <Grid x:Name="ContentLayer" Grid.Row="2">
      <TabView x:Name="Tabs"
               Background="Transparent"
               AddTabButtonClick="OnAddTab"
               TabCloseRequested="OnTabClose"
               SelectionChanged="OnTabSelChanged"
               DragOver="OnDragOver"
               Drop="OnDrop"/>

      <!-- 编辑器宿主：不放进标签内容（部分系统上标签内容会被裁成一行），
           直接铺满标签栏以下整个区域，按选中标签切换显示 -->
      <Grid x:Name="EditorHost" Margin="0,44,0,0"/>

      <local:FindReplacePanel x:Name="FindPanel"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Right"
                              Margin="0,8,16,0"
                              Visibility="Collapsed"/>
    </Grid>

    <!-- 状态栏 -->
    <Border x:Name="StatusBar" Grid.Row="3" Padding="14,5" BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock x:Name="PosText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="SelText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="LenText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="LinesText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="ZoomText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="EncText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="EolText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="LangText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
