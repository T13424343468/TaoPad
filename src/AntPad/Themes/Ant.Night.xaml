  <SolidColorBrush x:Key="Ant.SelBg" Color="#264F78"/>
  <SolidColorBrush x:Key="Ant.MatchBg" Color="#4A3D1E"/>

  <!-- 语法配色（VS 深色风格） -->
  <SolidColorBrush x:Key="Ant.TokKeyword" Color="#7FB0CC"/>
  <SolidColorBrush x:Key="Ant.TokControl" Color="#A8B8C4"/>
  <SolidColorBrush x:Key="Ant.TokString" Color="#C9A98A"/>
  <SolidColorBrush x:Key="Ant.TokComment" Color="#7A7466"/>
  <SolidColorBrush x:Key="Ant.TokDocComment" Color="#8A8474"/>
  <SolidColorBrush x:Key="Ant.TokNumber" Color="#B8AE8E"/>
