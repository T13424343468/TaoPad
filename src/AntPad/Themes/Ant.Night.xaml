    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 墨夜 —— 暖炭底宣纸白黛青点缀（Tao 系列统一深色主题，母本 TaoZip v53）（主题三象之一，色板唯一来源见 Services/ThemeRule.cs 注释，一致性由测试维度 O2 把关） -->
  <SolidColorBrush x:Key="Ant.Bg" Color="#131211"/>
  <SolidColorBrush x:Key="Ant.Surface" Color="#211E1B"/>
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#211E1B"/>
  <SolidColorBrush x:Key="Ant.ScrollThumb" Color="#66E8E3D5"/>
  <SolidColorBrush x:Key="Ant.ScrollThumbHover" Color="#99E8E3D5"/>
  <SolidColorBrush x:Key="Ant.Border" Color="#5C574C"/>
  <SolidColorBrush x:Key="Ant.Text" Color="#E8E3D5"/>
  <SolidColorBrush x:Key="Ant.Text2" Color="#ABA595"/>
  <SolidColorBrush x:Key="Ant.SubText" Color="#ABA595"/>
  <SolidColorBrush x:Key="Ant.Accent" Color="#6FA3BC"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#6FA3BC"/>

  <!-- 编辑器 -->
  <SolidColorBrush x:Key="Ant.EdBg" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Ant.EdText" Color="#E8E3D5"/>
  <SolidColorBrush x:Key="Ant.GutterBg" Color="#191919"/>
