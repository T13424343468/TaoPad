<Project Sdk="Microsoft.NET.Sdk">

  <!-- R1 重建：v1.7.0 测试报告载明 41 项逻辑回归，资产在 v1.9.12 源码树中丢失。
       本工程为纯逻辑回归（net10.0 控制台），只编译零 WinUI 依赖的五个逻辑文件，
       沙箱与云上均可运行；此后修坑必带回归断言（审查台账 R1 处置）。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LogicTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/AntPad/Syntax/Tokenizer.cs" />
    <Compile Include="../../src/AntPad/Syntax/CommentCommands.cs" />
    <Compile Include="../../src/AntPad/Services/CodeFormatter.cs" />
    <Compile Include="../../src/AntPad/Services/CompletionEngine.cs" />
    <Compile Include="../../src/AntPad/Services/EncodingHelper.cs" />
    <!-- 1.1.0 写作模式与 C# 智能补全纯逻辑件 -->
    <Compile Include="../../src/AntPad/Services/TaoPaths.cs" />
    <Compile Include="../../src/AntPad/Services/WritingDoc.cs" />
    <Compile Include="../../src/AntPad/Services/CSharpIntel.cs" />
    <Compile Include="../../src/AntPad/Services/UndoStepper.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- CSharpIntel 的分析引擎（与主工程同版本，net10.0 控制台可直接用） -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

</Project>
